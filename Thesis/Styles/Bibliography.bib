@article{senn2025,
	title = {Mapping rhetorical styles in political crisis communication},
	volume = {0},
	issn = {0144-2872},
	url = {https://doi.org/10.1080/01442872.2025.2546385},
	doi = {10.1080/01442872.2025.2546385},
	abstract = {Crisis communication is inherently rhetorical, as it seeks to persuade audiences to accept interpretations, follow directives, and trust leaders. Studies that apply Aristotle's triad of appeals to character (ethos), emotion (pathos), and reason (logos) for analyzing mechanisms of persuasion in crisis communication offer valuable insights on the individual use of these appeals. Yet the literature still lacks an understanding of how these appeals are combined into distinct rhetorical styles. To address this limitation, this article examines the question of how rhetorical styles can be identified in political crisis communication. It proposes a quantitative approach that uses dictionary-based methods to detect the three appeals and K-means clustering to analyze their co-occurrence. Applied to a dataset of 483 televised press conferences by 300 speakers during the COVID-19 pandemic across ten countries, the analysis identifies four rhetorical styles in political crisis communication: (i) awareness-oriented, (ii) action-oriented, (iii) information-oriented, and (iv) leadership-oriented styles. The approach offers a foundation for comparing rhetorical styles across actors, countries, and crisis phases, and contributes a replicable tool for the study of crisis communication.},
	number = {0},
	urldate = {2026-04-26},
	journal = {Policy Studies},
	publisher = {Routledge},
	author = {Senn, Martin and Schwaderer, Christian and Hayek, Lore and Dingler, Sarah C.},
	month = aug,
	year = {2025},
	note = {\_eprint: https://doi.org/10.1080/01442872.2025.2546385},
	keywords = {computational rhetoric, COVID-19, Political crisis communication, quantitative rhetorical analysis, quantitative text analysis, rhetoric, rhetorical style},
	pages = {1--21},
	file = {Full Text PDF:/Users/zacharystuck/Zotero/storage/7NUEK2N9/Senn et al.-2025-Mapping rhetorical styles in political crisis communication.pdf:application/pdf},
}

