	file = {Preprint PDF:/Users/zacharystuck/Zotero/storage/EJMD2DCY/Punger{\v s}ek et al.-2026-Supercharging Agenda Setting Research The ParlaCAP Dataset of 28 European Parliaments and a Scalabl.pdf:application/pdf;Snapshot:/Users/zacharystuck/Zotero/storage/2EFT6JGU/2602.html:text/html},
