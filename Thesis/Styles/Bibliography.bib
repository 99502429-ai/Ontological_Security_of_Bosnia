@article{donnellyCriticalSecurityHistory2019,
	title = {Critical {Security} {History}: ({De})securitisation, ontological security, and insecure memories},
	volume = {4},
	copyright = {https://www.cambridge.org/core/terms},
	issn = {2057-5637, 2057-5645},
	shorttitle = {Critical {Security} {History}},
	url = {https://www.cambridge.org/core/product/identifier/S2057563719000051/type/journal_article},
	doi = {10.1017/eis.2019.5},
	abstract = {This article makes a case for incorporating the concept of {\textquoteleft}Critical Security History{\textquoteright} (CSH) into security studies. While history plays a powerful role in a cornucopia of security stories, we contend that it often goes unnoticed in scholarly research and teaching. Against this backdrop, we present a detailed guide to study how history is told and enacted in non-linear ways. To do this, the article outlines how CSH can contribute to securitisation and ontological security studies. As shown, this lens casts a new light on the legacies of (de)securitisation processes and how they are commemorated. It also illustrates that ontological security studies have only begun to call into question the concept of historicity. Working through these observations, the article marshals insights from Halvard Leira{\textquoteright}s notion of {\textquoteleft}engaged historical amateurism{\textquoteright} to entice scholars interested in {\textquoteleft}doing{\textquoteright} CSH. While acknowledging that this research agenda is hard to achieve, our study of the 2012 Sarajevo Red Line project helps to illustrate the added value of trying to {\textquoteleft}do{\textquoteright} CSH in theory and in practice. We end with some reflections for future research and continued conversations.},
	language = {en},
	number = {2},
	urldate = {2026-01-14},
	journal = {European Journal of International Security},
	author = {Donnelly, Faye and Steele, Brent J.},
	month = jun,
	year = {2019},
	pages = {209--226},
	file = {PDF:/Users/zacharystuck/Zotero/storage/N2VDQ2MI/Donnelly and Steele - 2019 - Critical Security History (De)securitisation, ontological security, and insecure memories.pdf:application/pdf},
}

