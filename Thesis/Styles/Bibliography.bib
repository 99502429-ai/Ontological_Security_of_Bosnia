@article{kinnvall2004,
	title = {Globalization and {Religious} {Nationalism}: {Self}, {Identity}, and the {Search} for {Ontological} {Security}},
	volume = {25},
	issn = {0162-895X, 1467-9221},
	shorttitle = {Globalization and {Religious} {Nationalism}},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/j.1467-9221.2004.00396.x},
	doi = {10.1111/j.1467-9221.2004.00396.x},
	abstract = {The globalization of economics, politics, and human affairs has made individuals and groups more ontologically insecure and existentially uncertain. One main response to such insecurity is to seek reaffirmation of one's self identity by drawing closer to any collective that is perceived as being able to reduce insecurity and existential anxiety. The combination of religion and nationalism is a particularly powerful response (“identity‐signifier”) in times of rapid change and uncertain futures, and is therefore more likely than other identity constructions to arise during crises of ontological insecurity.},
	language = {en},
	number = {5},
	urldate = {2026-02-25},
