@article{sethPostcolonialTheoryCritique2011,
	title = {Postcolonial {Theory} and the {Critique} of {International} {Relations}},
	volume = {40},
	issn = {0305-8298, 1477-9021},
	url = {https://journals.sagepub.com/doi/10.1177/0305829811412325},
	doi = {10.1177/0305829811412325},
	abstract = {This article in three parts offers the beginnings of a postcolonial critique of mainstream International Relations (IR). The first part argues that IR, where it has been interested in history at all, has misdescribed the origins and character of the contemporary international order, and that an accurate understanding of the {\textquoteleft}expansion of the international system{\textquoteright} requires attention to its colonial origins. The second part suggests that IR is deeply Eurocentric, not only in its historical account of the emergence of the modern international order, but also in its account(s) of the nature and functioning of this order. The human sciences are heirs to a tradition of knowledge which defines knowledge as a relation between a cognising, representing subject and an object, such that knowledge is always {\textquoteleft}of{\textquoteright} something out there, which exists independently of its apprehension. The third part of the article suggests that knowledges serve to constitute that which they purport to merely cognise or represent, and that IR theory serves to naturalise that which is historically produced.},
	language = {en},
	number = {1},
	urldate = {2026-01-14},
	journal = {Millennium: Journal of International Studies},
	author = {Seth, Sanjay},
	month = sep,
	year = {2011},
	pages = {167--183},
	file = {PDF:/Users/zacharystuck/Zotero/storage/BWX4QC8R/Seth - 2011 - Postcolonial Theory and the Critique of International Relations.pdf:application/pdf},
}

