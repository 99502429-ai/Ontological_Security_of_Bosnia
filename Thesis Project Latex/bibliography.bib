@article{donnelly_critical_2019,
	title = {Critical Security History: (De)securitisation, ontological security, and insecure memories},
	volume = {4},
	rights = {https://www.cambridge.org/core/terms},
	issn = {2057-5637, 2057-5645},
	url = {https://www.cambridge.org/core/product/identifier/S2057563719000051/type/journal_article},
	doi = {10.1017/eis.2019.5},
	shorttitle = {Critical Security History},
	abstract = {This article makes a case for incorporating the concept of ‘Critical Security History’ ({CSH}) into security studies. While history plays a powerful role in a cornucopia of security stories, we contend that it often goes unnoticed in scholarly research and teaching. Against this backdrop, we present a detailed guide to study how history is told and enacted in non-linear ways. To do this, the article outlines how {CSH} can contribute to securitisation and ontological security studies. As shown, this lens casts a new light on the legacies of (de)securitisation processes and how they are commemorated. It also illustrates that ontological security studies have only begun to call into question the concept of historicity. Working through these observations, the article marshals insights from Halvard Leira’s notion of ‘engaged historical amateurism’ to entice scholars interested in ‘doing’ {CSH}. While acknowledging that this research agenda is hard to achieve, our study of the 2012 Sarajevo Red Line project helps to illustrate the added value of trying to ‘do’ {CSH} in theory and in practice. We end with some reflections for future research and continued conversations.},
	pages = {209--226},
	number = {2},
	journaltitle = {European Journal of International Security},
	shortjournal = {Eur j.of int. secur.},
	author = {Donnelly, Faye and Steele, Brent J.},
	urldate = {2025-10-28},
	date = {2019-06},
	langid = {english},
	keywords = {notion},
	file = {PDF:/Users/zacharystuck/Zotero/storage/89RA9TPP/Donnelly and Steele - 2019 - Critical Security History (De)securitisation, ontological security, and insecure memories.pdf:application/pdf},
}

